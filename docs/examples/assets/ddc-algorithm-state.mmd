flowchart TB
    scan["Caller walks the physical scan timeline"]
    select{"Schedule record type?"}
    gap["Transition gap<br/>preserve ADC samples and global ticks;<br/>no DDC call"]
    prepare["Select one complete PRI<br/>convert stored int16 to real double [N,C]<br/>retain identity and global start tick"]
    ddc["One vectorized MATLAB call<br/>processFrame(adcPriSamples, design)<br/>fresh oscillator n=0 and local FIR/decimator state"]
    out["Return complex [N/12,C]<br/>scalar sample-domain metadata<br/>retain startup; no appended zero flush or tail"]
    discard["Discard local state at call end"]
    timing["Caller assigns global timestamps and applies<br/>372-tick delay mapping once"]
    validity["Downstream range responsibility<br/>complete-window validity for startup,<br/>blanking, and PRI end; not implemented here"]
    more{"More scan records?"}
    finish([End scan])

    scan --> select
    select -- "transition" --> gap --> more
    select -- "priming or usable PRI" --> prepare --> ddc --> out --> discard --> timing --> more
    out -. "validity ownership" .-> validity
    more -- "yes" --> select
    more -- "no" --> finish

    classDef data fill:#eaf3ff,stroke:#2864a0,color:#10263b
    classDef state fill:#f5f1e8,stroke:#80642e,color:#34280d
    class scan,gap,prepare,out,timing,validity data
    class discard state
    linkStyle default stroke:#43515e,color:#10263b
